                                                </a>
                                                <a class="btn btn-danger" href="/admin/car/delete?id=@carItem.CarID" title="Sil">
                                                    <i class="fa fa-trash fa-lg" aria-hidden="true"></i>
                                                </a>
                                                <a class="btn btn-warning" href="/admin/car/update?id=@carItem.CarID" title="Güncelle">
                                                    <i class="fa fa-pen fa-lg" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody> *@
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            $("#CarDataTable").DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                lengthMenu: [5,10,20],
                language:{
                    lengthMenu: "Sayfada _MENU_ kayıt göster",
                    info: "Gösterilen _START_ - _END_ / Toplam _TOTAL_ Kayıt",
                    infoEmpty: "Gösterilecek Kayıt Bulunamadı!",
                },
                ajax:{
                    url:"/Admin/Car/PagingIndex",
                    type: "POST",
                    dataSrc: (json)=>{
                        console.log("AJAX Data: ",json);
                        return json.data;
                    }
                },
                columns:[
                    {data: null,
                        orderable: false,
                        "render": function(data,type,row){
                            return `<img src="/assets/car_photos/${row.bigImageURL}" alt="car-image" style="width: 75px; height: 50px" />`;
                        }
                    },
                    {data:"brand.brandName"},
                    {data:"model"},
                    {data:"km"},
                    {data:"transmission"},
                    {data:null,
                        orderable: false,
                        "render": function(data,type,row){
                            return `<a href="/admin/carfeature/carfeaturedetail?id=${row.carID}" class="btn btn-outline-success mi-4">
                                        <i class="fa fa-certificate fa-lg" aria-hidden="true"></i>
                                    </a>`;
                        }
                    },
                    {data:null,
                        orderable: false,
                        "render": function(data,type,row){
                            return `<a href="/admin/carreview/${row.carID}" class="btn btn-outline-primary mi-4">
                                        <i class="fa fa-comment fa-lg" aria-hidden="true"></i>
                                    </a>`;
                        }
                    },
                    {data:null,
                        orderable: false,
                        "render": function(data,type,row){
                            return `<a href="/admin/carpricing?id=${row.carID}" class="btn btn-outline-success mi-4">
                                        <i class="fas fa-money-bill-wave fa-lg" aria-hidden="true"></i>
                                    </a>`;
                        }
                    },
                    {data:null,
                        orderable: false,
                        "render": function(data,type,row){
                            return `<a class="btn btn-info" href="/admin/car/detail?id=${row.carID}" title="detaylar">
                                        <i class="fa fa-info-circle fa-lg" aria-hidden="true"></i>
                                    </a>
                                    <a class="btn btn-danger" href="/admin/car/delete?id=${row.carID}" title="sil">
                                        <i class="fa fa-trash fa-lg" aria-hidden="true"></i>
                                    </a>
                                    <a class="btn btn-warning" href="/admin/car/update?id=${row.carID}" title="güncelle">
                                        <i class="fa fa-pen fa-lg" aria-hidden="true"></i>
                                    </a>`;
                        }
                    }
                ]
            });
        });
    </script>
}