@model ProfileSettingUIModel

@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="col-lg-8">
    <div class="card">
        <div class="card-header">
            Şifre Değişikliği
        </div>
        <div class="card-body card-block">
            <form id="ChangePasswordForm" asp-area="User" asp-controller="UserProfile" asp-action="ChangePassword" method="post">
                <div class="form-group">
                    <input asp-for="@Model.ChangePassword.Password" type="password" class="form-control" placeholder="Mevcut Şifre">
                    @if (!ViewContext.ModelState.IsValid && ViewContext.ModelState["ChangePassword.Password"].Errors.Any())
                    {
                        <span asp-validation-for="@Model.ChangePassword.Password" class="alert-danger d-flex justify-content-center"></span>
                    }
                </div>
                <div class="form-group">
                    <input asp-for="@Model.ChangePassword.NewPassword" type="password" class="form-control" placeholder="Yeni Şifre">
                    @if (!ViewContext.ModelState.IsValid && ViewContext.ModelState["ChangePassword.NewPassword"].Errors.Any())
                    {
                        <span asp-validation-for="@Model.ChangePassword.NewPassword" class="alert-danger d-flex justify-content-center"></span>
                    }
                </div>
                <div class="form-group">
                    <input asp-for="@Model.ChangePassword.ConfirmNewPassword" type="password" class="form-control" placeholder="Yeni Şifre Tekrar">
                    @if (!ViewContext.ModelState.IsValid && ViewContext.ModelState["ChangePassword.ConfirmNewPassword"].Errors.Any())
                    {
                        <span asp-validation-for="@Model.ChangePassword.ConfirmNewPassword" class="alert-danger d-flex justify-content-center"></span>
                    }
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa fa-dot-circle-o"></i> Şifre Sıfırla
                    </button>
                    <a href="/user/home" class="btn btn-danger btn-sm">
                        <i class="fa fa-ban"></i> Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>