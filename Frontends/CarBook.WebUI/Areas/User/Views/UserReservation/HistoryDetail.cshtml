@model ReservationUIViewModel

@{
    ViewData["Title"] = ViewBag.PageTitle;
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<link href="~/css/ticket.css" rel="stylesheet" />

<div class="col-lg-12">
    <div class="card">
        <div class="card-body" style="display: flex; justify-content: center; align-items: center;">
            <div class="row position-relative ticket-container">

                <!-- Sağ Taraf -->
                <div class="col-9 border-bottom-dashed">
                    <div class="row mx-2 mt-4 mb-2 pb-2 border-bottom ">
                        <div class="col-12 d-flex justify-content-between align-items-center">
                            <img src="~/assets/travle_icon.png" class="mr-1 ticker-header-img" />
                            <div class="ticket-header-text font-weight-bold"> CARBOOK TICKET</div>
                            <div class="d-flex flex-column ticket-header-resvr">
                                <span>Rezervasyon Tarihi</span>
                                <span>@(Model.ResultData.PickUpDate.ToString("dd.MM.yyyy HH:mm"))</span>
                            </div>
                        </div>
                    </div>
                    <div class="row text-fs-10 border-bottom mx-2 mb-2 pb-2 font-weight-bold">
                        <div class="col-8 text-color-black border-right">
                            <div class="pb-2"><span>LOKASYON BİLGİLERİ</span></div>
                            <div><span>ALIŞ: @Model.ResultData.PickUpLocation.LocationName</span></div>
                            <div><span>TESLİM: @Model.ResultData.DropOffLocation.LocationName</span></div>
                        </div>
                        <div class="col-4">
                            <div class="text-color-black pb-2">SÜRÜCÜ BİLGİLERİ</div>
                            <div><span class="text-color-white">ADI: @Model.ResultData.Name</span></div>
                            <div><span class="text-color-white">SOYADI: @Model.ResultData.Surname</span></div>
                        </div>
                    </div>
                    <div class="row text-fs-10 border-bottom mx-2 mb-2 pb-2 font-weight-bold">
                        <div class="col-8 text-color-black border-right">
                            <div class="pb-2"><span>TARİH BİLGİLERİ</span></div>
                            <div><span>ALIŞ: @(Model.ResultData.PickUpDate.ToString("dd.MM.yyyy HH:mm"))</span></div>
                            <div><span>TESLİM: @(Model.ResultData.DropOffDate.ToString("dd.MM.yyyy HH:mm"))</span></div>
                        </div>
                        <div class="col-4 text-color-black">
                            <div class="pb-2"><span>ARAÇ BİLGİLERİ</span></div>
                            <div><span>MARKA: @Model.ResultData.Car.Brand.BrandName</span></div>
                            <div>PLAKA: <span class="text-color-white">26 ESK 2626</span></div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <span class="pl-4" style="font-size: .55rem; font-style: italic; opacity: .5; color: #fff;">
                            *** @Model.ResultData.Car.Brand.BrandName / @Model.ResultData.Car.Model - 34 ESK 2626 aracınızı almak için alış saatinin en geç 30 dakika sonrasına gelmeniz gerekmektedir.
                        </span>
                    </div>

                </div>

                <!-- Sol Taraf -->
                <div class="col-3 d-flex justify-content-center align-items-center ticket-company-direction">
                    <div class="ticket-company-name">
                        <span class="ticket-company-firstname">CAR</span> <span class="ticket-company-lastname">BOOK</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>