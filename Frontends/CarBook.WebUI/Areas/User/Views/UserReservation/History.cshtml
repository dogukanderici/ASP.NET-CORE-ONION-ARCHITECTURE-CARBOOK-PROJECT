@model ReservationUIViewModel

@{
    ViewData["Title"] = ViewBag.PageTitle;
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="col-lg-12">
    <div class="card">
        <div class="card-header">
            <strong class="card-title">@ViewBag.SubPageTitle</strong>
        </div>
        <div class="card-body">
            @if (Model.ResultDatas.Count() > 0)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Ad / Soyad</th>
                            <th scope="col">E-Posta</th>
                            <th scope="col">Alış Tarihi</th>
                            <th scope="col">Teslim Tarihi</th>
                            <th scope="col">Araç Model</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in Model.ResultDatas)
                        {
                            <tr>
                                <th scope="row">@($"{history.Name} {history.Surname}")</th>
                                <td>@history.Email</td>
                                <td>@history.PickUpDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@history.DropOffDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@($"{history.Car.Brand.BrandName} {history.Car.Model}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center d-flex justify-content-center align-items-center">
                    <i class="fa fa-info-circle fa-2x mx-2" aria-hidden="true"></i> <span>Henüz Araç Kiralama İşleminiz Bulunmuyor!</span>
                </div>
            }
        </div>
    </div>
</div>