@model AuthUIViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_AuthHeadComponentPartial", new { pageTitle = ViewBag.PageTitle })

<body>

    <div>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="d-flex align-items-center min-vh-100">
                        <div class="w-100 d-block bg-white shadow-lg rounded my-5">
                            <div class="row">
                                <div class="col-lg-6 d-none d-lg-block bg-login rounded-left" style="padding-bottom: 12px; padding-top: 12px;">
                                    <img src="~/assets/images/login_image.jpg" class="rounded" alt="Login_Image" style="width:546px; height: 442px;" />
                                </div>
                                <div class="col-lg-6 d-flex justify-content-center">
                                    <div class="p-5 w-75">
                                        <div class="text-center mb-5">
                                            <a href="index.html" class="text-dark font-size-22 font-family-secondary">
                                                <b>CarBook @ViewBag.PageTitle</b>
                                            </a>
                                        </div>
                                        @if (!Model.ResponseState)
                                        {
                                            <div class="row d-flex justify-content-center align-items-center">
                                                <div class="alert alert-danger">@Model.ResponseMessage</div>
                                            </div>
                                        }
                                        <h1 class="h5 mb-1">Hoşgeldiniz!</h1>
                                        <p class="text-muted mb-4">Kullanıcı Adı ve şifrenizi girerek kullanıcı sayfasına erişebilirsiniz!</p>
                                        <form asp-controller="Login" asp-action="Index" class="user" method="post">
                                            <div class="form-group">
                                                <input asp-for="@Model.UserLogin.Username" type="text" class="form-control form-control-user" placeholder="Kullanıcı Adı">
                                                @if (ViewBag.ModelStateIsValid != null)
                                                {
                                                    if (!ViewBag.ModelStateIsValid && ViewContext.ModelState["UserLogin.Username"].Errors.Any())
                                                    {
                                                        <span asp-validation-for="@Model.UserLogin.Username" class="form-control d-flex justify-content-center align-items-center alert alert-danger"></span>
                                                    }
                                                }
                                            </div>
                                            <div class="form-group">
                                                <input asp-for="@Model.UserLogin.Password" type="password" class="form-control form-control-user" placeholder="Şifre">
                                                @if (ViewBag.ModelStateIsValid != null)
                                                {
                                                    if (!ViewBag.ModelStateIsValid && ViewContext.ModelState["UserLogin.Password"].Errors.Any())
                                                    {
                                                        <span asp-validation-for="@Model.UserLogin.Password" class="form-control d-flex justify-content-center align-items-center alert alert-danger"></span>
                                                    }
                                                }
                                            </div>
                                            <button type="submit" class="btn btn-success btn-block waves-effect waves-light"> Giriş Yap </button>

                                        </form>

                                        <div class="row mt-4">
                                            <div class="col-12 text-center">
                                                <p class="text-muted mb-2"><a href="/Auth/ForgotMyPassword" class="text-muted font-weight-medium ml-1">Şifremi Unuttum</a></p>
                                                <p class="text-muted mb-0">Bir hesabınız yok mu? <a href="/Register" class="text-muted font-weight-medium ml-1"><b>Kayıt ol</b></a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("_AuthScriptComponentPartial")

</body>

</html>