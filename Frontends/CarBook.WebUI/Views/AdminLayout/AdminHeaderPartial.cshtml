<header id="page-topbar">
    <div class="navbar-header">

        <div class="d-flex align-items-left">
            <button type="button" class="btn btn-sm mr-2 d-lg-none px-3 font-size-16 header-item waves-effect" id="vertical-menu-btn">
                <i class="fa fa-fw fa-bars"></i>
            </button>

            <div class="dropdown d-none d-sm-inline-block">
                <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="mdi mdi-plus"></i> Yeni Oluştur
                    <i class="mdi mdi-chevron-down d-none d-sm-inline-block"></i>
                </button>
                <div class="dropdown-menu">

                    <a href="/admin/brand/create" class="dropdown-item notify-item">Yeni Marka Ekle</a>
                    <a href="/admin/car/create" class="dropdown-item notify-item">Yeni Araç Ekle</a>
                    <a href="/admin/blog" class="dropdown-item notify-item">Bloglar</a>
                    <a href="/admin/service" class="dropdown-item notify-item">Hizmetler</a>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center">

            <div class="dropdown d-inline-block ml-2">
                <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <img class="rounded-circle header-profile-user" src="~/assets/images/user_avatar.jpg"
                         alt="user-avatar">
                    <span class="d-none d-sm-inline-block ml-1">Test @ViewBag.AdminUserName</span>
                    <i class="mdi mdi-chevron-down d-none d-sm-inline-block"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item d-flex align-items-center justify-content-between" href="/Admin/Contact">
                        <span>Gelen Kutusu</span>
                    </a>
                    <a class="dropdown-item d-flex align-items-center justify-content-between" href="/user/profile">
                        <span>Profilim</span>
                    </a>
                    <a class="dropdown-item d-flex align-items-center justify-content-between" href="/user/profile/changepassword">
                        <span>Şifre Değiştirme</span>
                    </a>
                    <a class="dropdown-item d-flex align-items-center justify-content-between" href="/user/profile">
                        Ayarlar
                    </a>
                    <a class="dropdown-item d-flex align-items-center justify-content-between" href="/logout">
                        <span>Çıkış Yap</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</header>